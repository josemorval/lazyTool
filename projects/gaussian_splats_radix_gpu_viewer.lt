  clear 1 0.05 0.05 0.08 1 1 1
  clear_sources - -
  vertex_count 3
  instance 1
  threads 128 1 1
  compute_on_reset 0
  dispatch_from gs_sofa|gaussian_splat
  indirect_args - 0
  repeat 1 1
  parent gpu_gaussian_splat_viewer
  srvs 1 gs_sofa|gaussian_splat 0
  uavs 2 gs_indirect_args|structured_buffer 0 gs_sort_pairs_a|structured_buffer 1
  params 0
end_command

